+def _reward_stand_anchor(ctx: RewardContext) -> np.ndarray:
+    """锚点站立 (净位移/净旋转): 恢复锁存后, 罚离开站立点的净水平位移与净 yaw 旋转.
+
+    ★ v8: 解耦"平衡微调"与"净漂移"。v7 用 wheel_symmetry/5 + no_yaw + stand_still
